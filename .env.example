# Configurações do Servidor
PORT=
NODE_ENV=

# Segredo para gerenciar as sessões do Express
# Gere um valor aleatorio forte (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Defina TRUST_PROXY=1 somente se a aplicacao de producao estiver atras de um proxy HTTPS confiavel de um salto
TRUST_PROXY=

# Conexão com o Banco de Dados MariaDB
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=