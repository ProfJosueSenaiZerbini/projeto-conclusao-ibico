<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadastro - Ibico</title>
<link rel="stylesheet" href="/css/cadastro-trabalhador.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-left">
      <div class="logo">Ibico</div>
      <ul class="nav-links">
        <li><a href="#">Início</a></li>
        <li><a href="#">Vagas</a></li>
        <li><a href="#">Carteira</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <span class="balance">R$ 0,00</span>
      <span class="profile">Perfil</span>
    </div>
  </nav>

  <div class="main">
    <div class="col-left">
      <span class="tag">Oportunidades Locais</span>
      <h1 class="headline">Conectando talentos a demandas locais com clareza e agilidade.</h1>
      <p class="lead">Junte-se a milhares de profissionais e contratantes na plataforma de micro-freelances mais confiável do país.</p>
      <div class="visual-panel">
        <div class="mockup">
          <div class="bar"></div>
          <div class="bar" style="width:80%"></div>
          <div class="bar" style="width:40%"></div>
        </div>
      </div>
    </div>

    <div class="col-right">
      <h2>CRIAR NOVA CONTA</h2>
      <p class="desc">Preencha seus dados para começar a usar o Ibico</p>

      <span class="field-label">Eu quero...</span>
      <div class="role-toggle">
        <button type="button" class="role-btn active" id="btnTrabalhar" onclick="setRole('trabalhar')">🛠️ Quero Trabalhar</button>
        <button type="button" class="role-btn" id="btnContratar" onclick="setRole('contratar')">👤 Quero Contratar</button>
      </div>

      <form id="cadastroForm">
        <div class="row-2">
          <div class="field">
            <label class="field-label" for="nome">Nome Completo</label>
            <input type="text" id="nome" placeholder="Ex: João da Silva" required>
          </div>
          <div class="field">
            <label class="field-label" for="email">E-mail</label>
            <input type="email" id="email" placeholder="seu@email.com" required>
          </div>
        </div>

        <div class="row-2">
          <div class="field">
            <label class="field-label" for="telefone">Telefone/WhatsApp</label>
            <input type="tel" id="telefone" placeholder="(00) 00000-0000" required>
          </div>
          <div class="field">
            <label class="field-label" for="cpf">CPF</label>
            <input type="text" id="cpf" placeholder="000.000.000-00" required>
          </div>
        </div>

        <div class="row-2">
          <div class="field">
            <label class="field-label" for="senha">Senha</label>
            <div class="input-wrap">
              <input type="password" id="senha" placeholder="••••••••" required>
              <button type="button" class="toggle-pass" id="toggleSenha">👁</button>
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="confirmarSenha">Confirmar Senha</label>
            <div class="input-wrap">
              <input type="password" id="confirmarSenha" placeholder="••••••••" required>
              <button type="button" class="toggle-pass" id="toggleConfirmarSenha">👁</button>
            </div>
          </div>
        </div>

        <hr class="divider-line">

        <label class="check-row">
          <input type="checkbox" required>
          Li e aceito os <a href="#">Termos de Uso</a> e a <a href="#">Política de Privacidade</a>.
        </label>
        <label class="check-row">
          <input type="checkbox" required>
          Confirmo que possuo 18 anos ou mais. (Obrigatório para prestadores de serviço.)
        </label>

        <button type="submit" class="btn-primary">FINALIZAR CADASTRO</button>
      </form>

      <p class="login-line">Já possui uma conta? <a href="login.html">Faça o Login</a></p>
    </div>
  </div>

  <footer>
    <div>
      <div class="brand">Ibico</div>
      <p class="copy">© 2024 Ibico - Intermediação de Micro-Freelances. Todos os direitos reservados.</p>
    </div>
    <div class="foot-cols">
      <div class="foot-col">
        <h4>Ibico</h4>
        <a href="#">Sobre Nós</a>
        <a href="#">Termos de Uso</a>
      </div>
      <div class="foot-col">
        <h4>Suporte</h4>
        <a href="#">Privacidade</a>
        <a href="#">Ajuda</a>
        <a href="#">Contato</a>
      </div>
    </div>
  </footer>

  <script src="/js/cadastro-trabalhador.js"></script>
</body>
</html>
