<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ibico — Encontre sua próxima oportunidade</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/homeTrabalhador.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

    <%- include('Partials/headertrabalhador') %>

    <main>
        <div class="top-row">
            <div class="search-wrap">
                <h1 class="title">Encontre sua próxima oportunidade</h1>
                <!-- Mantem a lupa presa ao campo, e nao ao bloco inteiro da busca. -->
                <div class="search-input-wrap">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="text" id="searchInput" placeholder="Qual serviço você procura hoje?">
                </div>
            </div>
            <div class="sort-wrap">
                <span class="sort-label">Ordenar por</span>
                <select class="sort-select" id="sortSelect">
                    <option>Mais Recentes</option>
                    <option>Maior Preço</option>
                    <option>Menor Preço</option>
                    <option>Mais Próximos</option>
                </select>
            </div>
        </div>

        <div class="grid" id="cardsGrid">
            <% if (vagas.length===0) { %>
                <p style="text-align: center; color: #666; grid-column: 1 / -1; padding: 2rem;">Nenhum bico disponível
                    no momento. Tente novamente mais tarde!</p>
                <% } else { %>
                    <% vagas.forEach(vaga=> { %>
                        <div class="card">
                            <div class="card-head">
                                <div>
                                    <h3>
                                        <%= vaga.titulo %>
                                    </h3>
                                    <div class="location">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                            <circle cx="12" cy="10" r="3" />
                                        </svg>
                                        <%= vaga.bairro %>
                                    </div>
                                </div>
                                <span class="price-pill">R$ <%= vaga.valor %></span>
                            </div>

                            <div class="meta">
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <path d="M16 2v4M8 2v4M3 10h18" />
                                    </svg>
                                    <%= vaga.data_servico.toLocaleDateString('pt-BR') %>
                                </div>
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 3" />
                                    </svg>
                                    <%= vaga.horario %>
                                </div>
                            </div>

                            <div class="vaga-actions">
                                <!-- Botao destacado para levar aos dados completos da vaga. -->
                                <a href="/bicos/<%= vaga.id %>" class="btn-details">
                                    <i class="fas fa-eye"></i> Ver Detalhes
                                </a>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <div class="load-more-wrap">
            <button class="btn-outline" id="loadMoreBtn">Carregar mais vagas</button>
        </div>
    </main>

    <%- include('Partials/footer') %>

    <div class="toast" id="toast"></div>

    <script src="/js/homeTrabalhador.js"></script>

</body>

</html>