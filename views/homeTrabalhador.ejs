<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ibico — Encontre sua próxima oportunidade</title>
    <link rel="stylesheet" href="/css/homeTrabalhador.css">
</head>

<body>

    <header>
        <div class="logo">Ibico</div>
        <nav>
            <a href="#" class="active" data-page="inicio">início</a>
            <a href="#" data-page="carteira">Carteira</a>
            <a href="#" data-page="historico">Histórico</a>
        </nav>
        <div class="header-icons">
            <button class="icon-btn" id="bellBtn" title="Notificações">
                <span class="dot show" id="bellDot"></span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
            </button>
            <button class="icon-btn" id="profileBtn" title="Perfil">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6" />
                </svg>
            </button>
        </div>
    </header>

    <main>
        <div class="top-row">
            <div class="search-wrap">
                <h1 class="title">Encontre sua próxima oportunidade</h1>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" id="searchInput" placeholder="Qual serviço você procura hoje?">
            </div>
            <div class="sort-wrap">
                <span class="sort-label">Ordenar por</span>
                <select class="sort-select" id="sortSelect">
                    <option>Mais Recentes</option>
                    <option>Maior Preço</option>
                    <option>Menor Preço</option>
                    <option>Mais Próximos</option>
                </select>
            </div>
        </div>

        <div class="grid" id="cardsGrid">
            <% if (vagas.length===0) { %>
                <p style="text-align: center; color: #666; grid-column: 1 / -1; padding: 2rem;">Nenhum bico disponível
                    no momento. Tente novamente mais tarde!</p>
                <% } else { %>
                    <% vagas.forEach(vaga=> { %>
                        <div class="card">
                            <div class="card-head">
                                <div>
                                    <h3>
                                        <%= vaga.titulo %>
                                    </h3>
                                    <div class="location">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                            <circle cx="12" cy="10" r="3" />
                                        </svg>
                                        <%= vaga.bairro %>
                                    </div>
                                </div>
                                <span class="price-pill">R$ <%= vaga.valor %></span>
                            </div>

                            <div class="meta">
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <path d="M16 2v4M8 2v4M3 10h18" />
                                    </svg>
                                    <%= vaga.data_servico.toLocaleDateString('pt-BR') %>
                                </div>
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 3" />
                                    </svg>
                                    <%= vaga.horario %>
                                </div>
                            </div>

                            <div class="card-footer">
                                <button class="btn-apply"
                                    onclick="candidatar(this, '<%= vaga.titulo %>')">Candidatar-se</button>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <div class="load-more-wrap">
            <button class="btn-outline" id="loadMoreBtn">Carregar mais vagas</button>
        </div>
    </main>

    <footer>
        <div>
            <div class="logo">Ibico</div>
            <div class="footer-copy">© 2024 Ibico Intermediação Ltda. Inspirado na clareza da Araponga.</div>
        </div>
        <div class="footer-links">
            <a href="#">Termos</a>
            <a href="#">Privacidade</a>
            <a href="#">Suporte</a>
            <a href="#">Trabalhe Conosco</a>
        </div>
    </footer>

    <div class="toast" id="toast"></div>

    <script src="/js/homeTrabalhador.js"></script>

</body>

</html>