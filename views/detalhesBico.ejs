<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <title>Detalhes do Bico — Ibico</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/detalhesBico.css">
</head>

<body>

  <!-- O cabecalho acompanha o perfil que esta visualizando a oportunidade. -->
  <% if (usuario.tipo_perfil && usuario.tipo_perfil.toLowerCase()==='contratante' ) { %>
    <%- include('Partials/headerContratante') %>
      <% } else { %>
        <%- include('Partials/headertrabalhador') %>
          <% } %>

            <!-- BANNER HERO -->
            <div class="hero-banner">
              <div class="banner-container">
                <div class="banner-info">
                  <span class="badge-status">
                    <%= bico.status %>
                  </span>
                  <h1>
                    <%= bico.titulo %>
                  </h1>
                  <div class="banner-meta">
                    <span>📍 <%= bico.bairro %></span>
                    <span>📅 <%= bico.data_servico_formatada %></span>
                  </div>
                </div>
                <div class="banner-price">
                  <span class="price-label">VALOR TOTAL</span>
                  <div class="price-value">R$ <%= Number(bico.valor).toFixed(2).replace('.', ',' ) %>
                  </div>
                  <span class="price-sub">Pagamento via PIX</span>
                </div>
              </div>
            </div>

            <!-- MAIN CONTAINER -->
            <main class="main-container">
              <div class="content-left">
                <div class="section-block">
                  <h3>Descrição da Vaga</h3>
                  <p class="description-text">
                    <%= bico.descricao %>
                  </p>
                </div>

                <div class="section-block">
                  <h3>Informações Rápidas</h3>
                  <div class="grid-2">
                    <div class="info-card">
                      <span class="icon">⏰</span>
                      <div>
                        <span class="card-label">Horário</span>
                        <strong>
                          <%= bico.horario %>
                        </strong>
                      </div>
                    </div>
                    <div class="info-card">
                      <span class="icon">👔</span>
                      <div>
                        <span class="card-label">Traje</span>
                        <strong>Esporte Fino / Social</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SIDEBAR -->
              <aside class="sidebar-right">
                <div class="summary-card">
                  <h3>Candidatar-se</h3>
                  <div class="summary-item">
                    <span>Contratante</span>
                    <strong>
                      <%= bico.contratante_nome %>
                    </strong>
                  </div>

                  <% if (usuario.tipo_perfil && usuario.tipo_perfil.toLowerCase()==='trabalhador' ) { %>

                    <!-- SE O TRABALHADOR JÁ SE CANDIDATOU -->
                    <% if (minhaCandidatura) { %>
                      <div
                        style="margin-top: 15px; padding: 12px; border-radius: 8px; background-color: #e3f2fd; border: 1px solid #90caf9; text-align: center;">
                        <span style="font-size: 0.85rem; color: #1976d2; display: block;">Sua Candidatura:</span>
                        <strong style="font-size: 1.1rem; color: #0d47a1;">✓ <%= minhaCandidatura.status %></strong>
                        <small style="display: block; margin-top: 4px; color: #555;">Inscrito em <%=
                            minhaCandidatura.data_candidatura %></small>
                      </div>

                      <!-- SE AINDA NÃO SE CANDIDATOU E O BICO ESTÁ ABERTO -->
                      <% } else if (bico.status==='Aberto' ) { %>
                        <form action="/bicos/candidatar" method="POST" style="width: 100%; margin-top: 15px;">
                          <input type="hidden" name="bico_id" value="<%= bico.id %>">

                          <div style="margin-bottom: 12px; text-align: left;">
                            <label for="mensagem"
                              style="font-size: 0.85rem; color: #666; display: block; margin-bottom: 4px;">Mensagem
                              (opcional):</label>
                            <textarea name="mensagem" id="mensagem" rows="3"
                              placeholder="Apresente-se brevemente ou tire dúvidas..."
                              style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #ccc; font-size: 0.9rem; resize: vertical;"></textarea>
                          </div>

                          <button class="btn-accept" type="submit" style="width: 100%;">Quero este Bico</button>
                        </form>
                        <% } %>

                          <% } %>

                            <a href="/hometrabalhador" class="btn-back"
                              style="display: block; text-align: center; margin-top: 15px; text-decoration: none;">Voltar</a>
                </div>
              </aside>
            </main>

            <!-- PARTIAL DO FOOTER -->
            <%- include('Partials/footer') %>

</body>

</html>