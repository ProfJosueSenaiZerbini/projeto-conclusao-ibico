<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Publicar Novo Bico — Ibico</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/publicarBico.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

 <%- include('Partials/headerContratante') %>

  <main class="content">
    <div class="form-header">
      <div class="header-text">
        <h1>Publicar Novo Bico</h1>
        <p>Preencha os detalhes da demanda para encontrar os melhores parceiros locais.</p>
      </div>
      <div class="badge-verified">
        <i class="fas fa-check-circle"></i> Anúncio Verificado Ibico
      </div>
    </div>

    <form action="/bicos/novo" method="POST" class="main-card">
      <div class="input-group">
        <label>Título do Bico</label>
        <input type="text" name="titulo" placeholder="Ex: Montagem de móveis de escritório" required>
      </div>

      <div class="input-group">
        <label>Descrição detalhada</label>
        <textarea name="descricao" rows="5" placeholder="Descreva as tarefas, ferramentas necessárias e expectativas..." required></textarea>
      </div>

      <div class="row">
        <div class="input-group">
          <label>Valor da Diária (R$)</label>
          <div class="input-with-prefix">
            <span>R$</span>
            <input type="number" name="valor" step="0.01" placeholder="250" required>
          </div>
        </div>
        <div class="input-group">
          <label>Bairro</label>
          <div class="input-with-icon">
            <i class="fas fa-location-dot"></i>
            <input type="text" name="bairro" placeholder="Ex: Itaim Bibi" required>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="input-group">
          <label>Data da Execução</label>
          <input type="date" name="data_servico" required>
        </div>
        <div class="input-group">
          <label>Horário de Início</label>
          <input type="time" name="horario" required>
        </div>
      </div>

      <div class="balance-box">
        <div class="balance-info">
          <div class="wallet-icon"><i class="fas fa-wallet"></i></div>
          <div>
            <span class="label">SEU SALDO ATUAL</span>
            <span class="value">R$ <%= Number(usuario.saldo_simulado || 0).toFixed(2) %></span>
          </div>
        </div>
        <div class="balance-check">
          <p>Valor a Reter: <span class="highlight">R$ 0,00</span></p>
          <p class="status-ok"><i class="fas fa-check-circle"></i> Saldo suficiente disponível</p>
        </div>
      </div>

      <div class="form-actions">
        <a href="/homeContratante" class="btn-cancel">Cancelar</a>
        <button type="submit" class="btn-submit">
          <i class="fas fa-paper-plane"></i> Publicar Vaga
        </button>
      </div>
    </form>

    <div class="info-grid">
      <div class="info-card">
        <i class="far fa-lightbulb"></i>
        <div>
          <h4>Dica de Título</h4>
          <p>Seja claro e específico.</p>
        </div>
      </div>
      <div class="info-card">
        <i class="fas fa-shield-halved"></i>
        <div>
          <h4>Segurança Ibico</h4>
          <p>Pagamento garantido.</p>
        </div>
      </div>
      <div class="info-card">
        <i class="fas fa-users-line"></i>
        <div>
          <h4>Alcance Local</h4>
          <p>Média de 5 propostas/hora.</p>
        </div>
      </div>
    </div>
  </main>

<%- include('Partials/footer') %>

</body>
</html>