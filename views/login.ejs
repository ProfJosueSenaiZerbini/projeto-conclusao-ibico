<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Ibico - Login</title>
    <link rel="stylesheet" type="text/css" media="screen" href="/css/login.css">
</head>

<body>

    <div class="panel" id="panel">
        <div class="brand">Ibico</div>
        <h1>Bem-vindo de volta</h1>
        <p class="subtitle">Escolha como deseja acessar a plataforma</p>

        <div class="toggle-row">
            <button type="button" class="toggle-btn active-hire" id="btnHire" onclick="selectMode('hire')">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <rect x="3" y="7" width="18" height="13" rx="2" />
                    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <path d="M3 13h18" />
                </svg>
                Quero Contratar
            </button>
            <button type="button" class="toggle-btn" id="btnWork" onclick="selectMode('work')">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path
                        d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
                Quero Trabalhar
            </button>
        </div>

        <div class="field-wrap">
            <label>E-mail Corporativo ou Pessoal</label>
            <input type="email" placeholder="exemplo@ibico.com.br">
        </div>

        <div class="field-wrap">
            <div class="field-top">
                <label style="margin-bottom:0;">Senha</label>
                <a href="#" class="forgot">Esqueceu a senha?</a>
            </div>
            <input type="password" placeholder="••••••••">
            <span class="eye">👁</span>
        </div>

        <label class="remember">
            <input type="checkbox">
            Lembrar de mim neste dispositivo
        </label>

        <button class="submit-btn" id="submitBtn">Entrar na Plataforma →</button>

        <p class="signup">Não tem uma conta? <a href="#">Criar uma conta gratuitamente</a></p>

        <div class="divider">Ou entre com</div>

        <div class="social-row">
            <button class="social-btn">🔵 Google</button>
            <button class="social-btn">🔷 LinkedIn</button>
        </div>

        <p class="secure">🔒 Conexão Segura AES-256</p>
    </div>

    <div class="side">
        <div class="bird-layer show" id="birdHire"></div>
        <div class="bird-layer" id="birdWork"></div>
        <div class="side-caption" id="sideCaption">
            <div class="name">Araponga</div>
            <div class="latin">Procnias nudicollis</div>
        </div>
    </div>

    <script>
        function selectMode(mode) {
            const btnHire = document.getElementById('btnHire');
            const btnWork = document.getElementById('btnWork');
            const panel = document.getElementById('panel');
            const birdHire = document.getElementById('birdHire');
            const birdWork = document.getElementById('birdWork');
            const caption = document.getElementById('sideCaption');

            if (mode === 'hire') {
                btnHire.classList.add('active-hire');
                btnHire.classList.remove('active-work');
                btnWork.classList.remove('active-hire', 'active-work');
                panel.classList.remove('mode-work');

                birdWork.classList.remove('show');
                birdHire.classList.add('show');
                caption.innerHTML = '<div class="name">Araponga</div><div class="latin">Procnias nudicollis</div>';
            } else {
                btnWork.classList.remove('active-work');
                void btnWork.offsetWidth;
                btnWork.classList.add('active-work');
                btnHire.classList.remove('active-hire', 'active-work');
                panel.classList.add('mode-work');

                birdHire.classList.remove('show');
                birdWork.classList.add('show');
                caption.innerHTML = '<div class="name">Tiê-de-sangue</div><div class="latin">Ramphocelus bresilius</div>';
            }
        }
    </script>

</body>

</html>