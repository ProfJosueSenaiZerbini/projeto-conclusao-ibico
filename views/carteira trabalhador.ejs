<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Extrato da Carteira</title>
<link rel="stylesheet" href="/public/css/carteiraTrabalahdor.css">
</head>
<body>
<div class="page">

  <div class="title-row">
    <div>
      <h1>Extrato da Carteira</h1>
      <p>Gerencie seus ganhos e acompanhe suas transações com transparência.</p>
    </div>
    <div class="actions">
      <button class="btn btn-secondary">📄 Gerar Relatório</button>
      <button class="btn btn-primary">💳 Sacar via Pix</button>
    </div>
  </div>

  <div class="top-grid">
    <div class="balance-stack">
      <div class="card">
        <div class="balance-label">SALDO DISPONÍVEL</div>
        <div class="balance-value" id="saldo-disponivel">--</div>
        <div class="balance-delta" id="saldo-delta"></div>
      </div>
      <div class="card">
        <div class="balance-label">SALDO RETIDO</div>
        <div class="balance-value" id="saldo-retido">--</div>
        <div class="balance-sub" id="saldo-retido-info"></div>
      </div>
    </div>

    <div class="card">
      <div class="chart-header">
        <div>
          <h3>Crescimento Mensal</h3>
          <p>Acompanhamento de ganhos brutos</p>
        </div>
        <div class="chart-select">Últimos 6 meses ⌄</div>
      </div>
      <!-- Gráfico fixo (não vem do banco) -->
      <div class="bars">
        <div class="bar-col"><div class="bar" style="height:60px"></div><div class="bar-label">Jan</div></div>
        <div class="bar-col"><div class="bar" style="height:70px"></div><div class="bar-label">Fev</div></div>
        <div class="bar-col"><div class="bar" style="height:95px"></div><div class="bar-label">Mar</div></div>
        <div class="bar-col"><div class="bar" style="height:85px"></div><div class="bar-label">Abr</div></div>
        <div class="bar-col"><div class="bar" style="height:100px"></div><div class="bar-label">Mai</div></div>
        <div class="bar-col active"><div class="bar active" style="height:140px"></div><div class="bar-label">Jun</div></div>
      </div>
    </div>
  </div>

  <div class="card history-card">
    <div class="history-header">
      <h3>Histórico de Transações</h3>
      <div class="search-box">
        🔍
        <input type="text" id="filtro-bico" placeholder="Filtrar por nome, valor ou data/horário...">
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Descrição do Bico</th>
          <th>Data</th>
          <th>Status</th>
          <th>Valor</th>
        </tr>
      </thead>
      <tbody id="transacoes-body">
        <!-- linhas da tabela inseridas via JS -->
      </tbody>
    </table>
    <div class="see-all" id="abrir-historico">Ver todo o histórico</div>
  </div>

</div>

<!-- Modal: Histórico completo -->
<div class="modal-overlay" id="historico-modal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>Histórico Completo</h3>
      <button class="modal-close" id="fechar-historico">✕</button>
    </div>
    <div class="modal-search">
      <div class="search-box">
        🔍
        <input type="text" id="filtro-bico-modal" placeholder="Filtrar por nome, valor ou data/horário...">
      </div>
    </div>
    <div class="modal-scroll">
      <table>
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Descrição do Bico</th>
            <th>Data</th>
            <th>Status</th>
            <th>Valor</th>
          </tr>
        </thead>
        <tbody id="historico-completo-body">
          <!-- linhas inseridas via JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="/public/js/carteiraTrabalhador.js"></script>
</body>
</html>
