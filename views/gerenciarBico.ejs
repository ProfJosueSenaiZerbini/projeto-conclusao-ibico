<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>iBico - Gerenciar Bico</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/detalhesBico.css">
</head>

<body>

  <%- include('Partials/headerContratante') %>

    <main class="main-container py-4" style="max-width: 1100px; margin: 0 auto; padding: 20px;">

      <!-- Cabeçalho do Bico -->
      <div class="section-block"
        style="background: #fff; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #e0e0e0;">
        <span id="status-bico" class="badge"
          style="background-color: #e8f5e9; color: #2e7d32; padding: 6px 12px; border-radius: 20px; font-weight: 600;">•
          <%= bico.status %></span>
        <h1 style="margin-top: 15px;">
          <%= bico.titulo %>
        </h1>
        <p style="font-size: 1.3rem; font-weight: bold; color: #2e7d32; margin-top: 5px;">R$ <%=
            Number(bico.valor).toFixed(2).replace('.', ',' ) %>
        </p>

        <div style="display: flex; gap: 20px; margin-top: 15px; color: #555;">
          <span>📅 <strong>Data:</strong>
            <%= bico.data_servico_formatada %>
          </span>
          <span>⏰ <strong>Horário:</strong>
            <%= bico.horario %>
          </span>
          <span>📍 <strong>Bairro:</strong>
            <%= bico.bairro %>
          </span>
        </div>

        <p style="margin-top: 15px; color: #444;">
          <%= bico.descricao %>
        </p>
        <% if (Number(usuario.id || usuario.id_usuario) === Number(bico.contratante_id) && bico.status === 'Em andamento') { %>
          <form id="form-finalizar-bico" action="/bicos/<%= bico.id %>/finalizar" method="POST" style="margin-top: 18px;">
            <button id="btn-finalizar-bico" type="submit"
              style="background: #2e7d32; color: #fff; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: 600;">
              Finalizar Serviço
            </button>
          </form>
        <% } %>
        <p id="feedback-finalizar-bico" role="status" aria-live="polite" style="margin-top: 10px;"></p>
      </div>

      <% if (usuario && Number(usuario.id || usuario.id_usuario) === Number(bico.contratante_id)
        && bico.status === 'Finalizado' && Number(bico.trabalhador_id) > 0) { %>
        <section class="section-block evaluation-section" aria-labelledby="titulo-avaliacao-bico">
          <h2 id="titulo-avaliacao-bico">Avaliar trabalhador</h2>
          <a class="btn-back" href="/perfil/publico/<%= bico.trabalhador_id %>">Ver perfil e avaliações</a>
          <form id="form-avaliacao-bico" action="/bicos/<%= bico.id %>/avaliacao" method="POST">
            <fieldset class="evaluation-rating">
              <legend>Nota <span aria-hidden="true">*</span></legend>
              <div class="evaluation-stars">
                <% [5, 4, 3, 2, 1].forEach(nota => { %>
                  <input class="evaluation-star-input" type="radio" id="nota-<%= nota %>"
                    name="nota" value="<%= nota %>" required>
                  <label class="evaluation-star" for="nota-<%= nota %>" aria-label="<%= nota %> estrela<%= nota > 1 ? 's' : '' %>">★</label>
                <% }); %>
              </div>
            </fieldset>

            <label class="evaluation-comment-label" for="comentario-avaliacao">Comentário (opcional)</label>
            <textarea id="comentario-avaliacao" name="comentario" maxlength="500" rows="4"
              placeholder="Conte como foi o serviço (até 500 caracteres)."></textarea>

            <button id="btn-salvar-avaliacao" class="evaluation-submit" type="submit">
              Salvar avaliação
            </button>
            <p id="feedback-avaliacao-bico" class="evaluation-feedback" role="status" aria-live="polite"></p>
          </form>
          <p class="evaluation-note">
            Avaliações existentes não são carregadas neste formulário. Para editá-las com os dados atuais,
            será necessário futuramente consultar a avaliação salva e preencher os campos.
          </p>
        </section>
      <% } %>

      <!-- Lista de Candidatos Inscritos -->
      <div class="section-block"
        style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0;">
        <h2>Candidatos Inscritos (<%= candidatos.length %>)</h2>

        <% if (candidatos.length===0) { %>
          <p style="color: #666; margin-top: 15px;">Nenhum trabalhador se candidatou a esta vaga até o momento.</p>
          <% } else { %>
            <div class="candidates-list" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
              <% candidatos.forEach(c=> { %>
                <div class="candidate-card"
                  style="border: 1px solid #e0e0e0; padding: 15px; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; background: #fafafa;">
                  <div>
                    <h3 style="margin: 0; font-size: 1.1rem;">
                      <%= c.nome_trabalhador %> (<%= c.idade_trabalhador %> anos)
                    </h3>
                    <p style="margin: 4px 0; color: #666; font-size: 0.9rem;">E-mail: <%= c.email_trabalhador %>
                    </p>
                    <% if (c.mensagem) { %>
                      <p
                        style="margin: 8px 0; font-style: italic; color: #333; background: #fff; padding: 8px; border-radius: 4px; border-left: 3px solid #007bff;">
                        "<%= c.mensagem %>"
                      </p>
                      <% } %>
                        <small style="color: #888;">Candidatou-se em: <%= c.data_candidatura_formatada %></small> |
                        <small>Status: <strong>
                            <%= c.status_candidatura %>
                          </strong></small>
                  </div>

                  <!-- Ações do Contratante (só aparecem se a candidatura for Pendente e o bico estiver Aberto) -->
                  <% if (c.status_candidatura==='Pendente' && bico.status==='Aberto' ) { %>
                    <div style="display: flex; gap: 10px;">
                      <!-- Form Aceitar -->
                      <form action="/bicos/candidaturas/status" method="POST">
                        <input type="hidden" name="candidatura_id" value="<%= c.candidatura_id %>">
                        <input type="hidden" name="novo_status" value="Aceito">
                        <button type="submit"
                          style="background: #2e7d32; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600;">Aceitar</button>
                      </form>

                      <!-- Form Recusar -->
                      <form action="/bicos/candidaturas/status" method="POST">
                        <input type="hidden" name="candidatura_id" value="<%= c.candidatura_id %>">
                        <input type="hidden" name="novo_status" value="Recusado">
                        <button type="submit"
                          style="background: #c62828; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600;">Recusar</button>
                      </form>
                    </div>
                    <% } else if (c.status_candidatura==='Aceito') { %>
                      <a class="btn-back" href="/bicos/candidaturas/<%= c.candidatura_id %>/chat">Abrir conversa</a>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } %>

              <div style="margin-top: 25px;">
                <a href="/bicos/ativos" style="color: #555; text-decoration: none; font-weight: 500;">← Voltar para Meus
                  Bicos Ativos</a>
              </div>
      </div>

    </main>

    <%- include('Partials/footer') %>
    <script src="/js/gerenciarBico.js" defer></script>
</body>

</html>
