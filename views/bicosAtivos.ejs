<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>iBico - Meus Bicos Ativos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/bicosAtivos.css">
</head>
<body>

  <%- include('partials/headerContratante') %>

  <main class="dashboard-container">
    <!-- Cabeçalho -->
    <header class="dashboard-header">
      <div class="header-titles">
        <span class="category-tag">PAINEL DE ATIVIDADES</span>
        <h1>Meus Bicos Ativos</h1>
        <p>Acompanhe o que está rolando e mantenha tudo sob controle.</p>
      </div>
      <a href="/bicos/novo" class="btn-new-job">+ Publicar Novo Bico</a>
    </header>

    <!-- Cards de Métricas (Estatísticas) -->
    <section class="metrics-grid">
      <div class="metric-card">
        <div class="metric-icon icon-green">✓</div>
        <div class="metric-info">
          <span class="metric-label">Bicos ativos</span>
          <strong class="metric-value">04</strong>
          <span class="metric-sub text-green">+1 este mês</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon icon-yellow">🕒</div>
        <div class="metric-info">
          <span class="metric-label">Em andamento</span>
          <strong class="metric-value">02</strong>
          <span class="metric-sub text-muted">Tudo no prazo</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon icon-blue">💼</div>
        <div class="metric-info">
          <span class="metric-label">Investido no mês</span>
          <strong class="metric-value">R$ 1.240</strong>
          <span class="metric-sub text-green">+12% vs. julho</span>
        </div>
      </div>
    </section>

    <!-- Seção de Listagem -->
    <section class="content-section">
      <div class="section-bar">
        <div class="section-title">
          <h2>Seus bicos</h2>
          <p>4 oportunidades ativas</p>
        </div>

        <div class="filters-bar">
          <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Buscar bico...">
          </div>
          <div class="filter-tabs">
            <button class="filter-btn active">Todos <span>4</span></button>
            <button class="filter-btn">Abertos <span>2</span></button>
            <button class="filter-btn">Em andamento <span>2</span></button>
          </div>
        </div>
      </div>

      <!-- Grid de Bicos -->
      <div class="jobs-grid">
        
        <!-- Card 1 (Em andamento) -->
        <article class="job-card">
          <div class="job-card-header">
            <span class="badge badge-ongoing">• Em andamento</span>
            <button class="btn-more">•••</button>
          </div>
          <h3 class="job-title">Fotógrafo para ensaio de família</h3>
          <div class="job-meta">
            <span>📍 Jardim América</span>
            <span>🕒 Hoje, 14:00</span>
          </div>
          <div class="job-footer">
            <div class="user-info">
              <div class="avatar avatar-purple">LC</div>
              <div>
                <span class="user-role">Profissional</span>
                <strong class="user-name">Lucas Costa</strong>
              </div>
            </div>
            <div class="price-info">
              <span class="price-label">Valor combinado</span>
              <strong class="price-value">R$ 380</strong>
            </div>
          </div>
          <a href="/bicos/1" class="job-link">Ver Detalhes <span>→</span></a>
        </article>

        <!-- Card 2 (Aberto) -->
        <article class="job-card">
          <div class="job-card-header">
            <span class="badge badge-open">• Aberto</span>
            <button class="btn-more">•••</button>
          </div>
          <h3 class="job-title">Montagem de armário de cozinha</h3>
          <div class="job-meta">
            <span>📍 Vila Madalena</span>
            <span>🕒 Amanhã, 09:30</span>
          </div>
          <div class="job-footer">
            <div class="user-info">
              <div class="avatar avatar-proposals">+3</div>
              <div>
                <span class="user-role">Propostas</span>
                <strong class="user-name">3 profissionais</strong>
              </div>
            </div>
            <div class="price-info">
              <span class="price-label">Orçamento</span>
              <strong class="price-value">R$ 220</strong>
            </div>
          </div>
          <a href="/bicos/2" class="job-link">Ver Detalhes <span>→</span></a>
        </article>

        <!-- Card 3 (Em andamento) -->
        <article class="job-card">
          <div class="job-card-header">
            <span class="badge badge-ongoing">• Em andamento</span>
            <button class="btn-more">•••</button>
          </div>
          <h3 class="job-title">Manutenção do jardim</h3>
          <div class="job-meta">
            <span>📍 Alto da Lapa</span>
            <span>🕒 30 ago, 08:00</span>
          </div>
          <div class="job-footer">
            <div class="user-info">
              <div class="avatar avatar-blue">RA</div>
              <div>
                <span class="user-role">Profissional</span>
                <strong class="user-name">Rafael Alves</strong>
              </div>
            </div>
            <div class="price-info">
              <span class="price-label">Valor combinado</span>
              <strong class="price-value">R$ 160</strong>
            </div>
          </div>
          <a href="/bicos/3" class="job-link">Ver Detalhes <span>→</span></a>
        </article>

        <!-- Card 4 (Aberto) -->
        <article class="job-card">
          <div class="job-card-header">
            <span class="badge badge-open">• Aberto</span>
            <button class="btn-more">•••</button>
          </div>
          <h3 class="job-title">Instalação de prateleiras</h3>
          <div class="job-meta">
            <span>📍 Perdizes</span>
            <span>🕒 02 set, 16:30</span>
          </div>
          <div class="job-footer">
            <div class="user-info">
              <div class="avatar avatar-proposals">+5</div>
              <div>
                <span class="user-role">Propostas</span>
                <strong class="user-name">5 profissionais</strong>
              </div>
            </div>
            <div class="price-info">
              <span class="price-label">Orçamento</span>
              <strong class="price-value">R$ 120</strong>
            </div>
          </div>
          <a href="/bicos/4" class="job-link">Ver Detalhes <span>→</span></a>
        </article>

      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>