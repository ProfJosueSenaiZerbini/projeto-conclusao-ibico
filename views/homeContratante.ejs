<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Contratante — Ibico</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/homeContratante.css">
</head>
<body>

  <%- include('Partials/headerContratante') %>
  
  <div class="dashboard-container">

    <aside class="sidebar">
      <a href="/bicos/novo" class="btn btn-primary btn-block btn-publicar" style="text-decoration: none; display: block; text-align: center;">
        <span class="btn-icon">+</span> Publicar Novo Bico
      </a>

      <div class="support-card">
        <h3>Precisa de ajuda?</h3>
        <p>Nossa central de suporte está disponível 24h.</p>
        <a class="hint-link">Acessar Central →</a>
      </div>
    </aside>

    <main class="main-content">
      
      <section class="welcome-header">
        <h1>Olá, <%= usuario.nome %></h1>
        <p>Veja como estão os seus bicos e candidatos hoje.</p>
      </section>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-icon">💼</span>
            <span class="pill pill-green">Atualizado</span>
          </div>
          <span class="stat-label">Vagas Criadas</span>
          <h2 class="stat-value"><%= bicos ? bicos.length : 0 %></h2>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-icon">👥</span>
            <span class="pill pill-green">Ativos</span>
          </div>
          <span class="stat-label">Candidatos</span>
          <h2 class="stat-value"><%= candidaturasPendentes ?? 0 %></h2>
        </div>

        <div class="stat-card stat-card-highlight">
          <div class="stat-header">
            <span class="stat-icon">💳</span>
          </div>
          <span class="stat-label">Saldo Disponível</span>
          <h2 class="stat-value"><%= formatarMoedaBRL(usuario?.saldo_simulado) %></h2>
        </div>
      </section>

      <section class="vagas-section">
        <div class="section-header">
          <h2>Vagas Ativas</h2>
          <a href="/bicos/ativos" class="hint-link">Ver todas as vagas →</a>
        </div>

        <div class="vagas-list">
          
          <% if (bicosAtivos && bicosAtivos.length > 0) { %>
            <% bicosAtivos.forEach(bico => { %>
              
              <div class="vaga-card">
                <div class="vaga-info">
                  <div class="vaga-badges">
                    <% if (bico.status === 'Aberto') { %>
                      <span class="badge badge-open">ABERTO</span>
                    <% } else if (bico.status === 'Em andamento') { %>
                      <span class="badge badge-filled">EM ANDAMENTO</span>
                    <% } else { %>
                      <span class="badge badge-default"><%= bico.status.toUpperCase() %></span>
                    <% } %>
                    
                    <span class="vaga-date">📍 <%= bico.bairro %> • <%= formatarMoedaBRL(bico.valor) %></span>
                  </div>
                  
                  <h3 class="vaga-title"><%= bico.titulo %></h3>
                  <p class="vaga-location"><%= bico.descricao %></p>
                </div>

                <div class="vaga-actions">
                 <a href="/bicos/<%= bico.id %>/gerenciar" class="btn-primary"
                  style="padding: 6px 12px; font-size: 0.85rem; border-radius: 6px; text-decoration: none;">Ver detalhes
                </a>
                </div>
              </div>

            <% }); %>
          <% } else { %>
            <div class="empty-state">
              <p>Você não possui bicos ativos no momento.</p>
              <a href="/bicos/novo" class="btn btn-teal">Publicar Meu Primeiro Bico</a>
            </div>
          <% } %>

        </div>
      </section>

    </main>
  </div>
  
<%- include('Partials/footer') %>

</body>
</html>