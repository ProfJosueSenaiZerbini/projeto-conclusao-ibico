  <div class="dashboard-container">

    <aside class="sidebar">
      <a href="/bicos/novo" class="btn btn-primary btn-block btn-publicar" style="text-decoration: none; display: block; text-align: center;">
        <span class="btn-icon">+</span> Publicar Novo Bico
      </a>

      <div class="support-card">
        <h3>Precisa de ajuda?</h3>
        <p>Nossa central de suporte está disponível 24h.</p>
        <a href="#" class="hint-link">Acessar Central →</a>
      </div>
    </aside>

    <main class="main-content">

      <section class="welcome-header">
        <h1>Olá, <%= usuario.nome %></h1>
        <p>Veja como estão os seus bicos e candidatos hoje.</p>
      </section>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-icon">💼</span>
            <span class="pill pill-green">Atualizado</span>
          </div>
          <span class="stat-label">Vagas Criadas</span>
          <h2 class="stat-value"><%= bicos ? bicos.length : 0 %></h2>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-icon">👥</span>
            <span class="pill pill-green">Ativos</span>
          </div>
          <span class="stat-label">Candidatos</span>
          <h2 class="stat-value">0</h2>
        </div>

        <div class="stat-card stat-card-highlight">
          <div class="stat-header">
            <span class="stat-icon">💳</span>
          </div>
          <span class="stat-label">Saldo Disponível</span>
          <h2 class="stat-value">R$ <%= Number(usuario.saldo_simulado || 0).toFixed(2) %></h2>
        </div>
      </section>

      <section class="vagas-section">
        <div class="section-header">
          <h2>Vagas Ativas</h2>
          <a href="/bicos" class="hint-link">Ver todas as vagas →</a>
        </div>

        <div class="filter-bar" style="margin-bottom: 20px; display: flex; justify-content: flex-end; align-items: center; gap: 12px; flex-wrap: wrap;">
          <form method="GET" action="/homeContratante" style="display: flex; align-items: center; gap: 8px;">
            <input type="hidden" name="ordenar" value="<%= ordenacao %>">
            <input id="buscarBico" type="search" name="q" value="<%= busca %>" placeholder="Pesquisar bicos..." aria-label="Pesquisar bicos" style="padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;">
            <button type="submit" style="padding: 8px 14px; border: 0; border-radius: 6px; background: #0d9488; color: #fff; font-weight: 600; cursor: pointer;">Pesquisar</button>
          </form>

          <form method="GET" action="/homeContratante" style="display: flex; align-items: center; gap: 8px;">
            <input type="hidden" name="q" value="<%= busca %>">
            <label for="ordenarSelect" style="font-size: 0.9rem; color: #64748b; font-weight: 500;">Ordenar por:</label>
            <select id="ordenarSelect" name="ordenar" style="padding: 8px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.9rem; cursor: pointer;">
              <option value="recente" <%= ordenacao === 'recente' ? 'selected' : '' %>>Mais recentes</option>
              <option value="menor_valor" <%= ordenacao === 'menor_valor' ? 'selected' : '' %>>Menor valor</option>
              <option value="maior_valor" <%= ordenacao === 'maior_valor' ? 'selected' : '' %>>Maior valor</option>
            </select>
            <button type="submit" style="padding: 8px 14px; border: 0; border-radius: 6px; background: #0d9488; color: #fff; font-weight: 600; cursor: pointer;">Buscar filtro</button>
          </form>
        </div>

        <div class="vagas-list">

          <% if (bicos && bicos.length > 0) { %>
            <% bicos.forEach(bico => { %>

              <div class="vaga-card" data-valor="<%= Number(bico.valor || 0) %>" data-id="<%= bico.id %>">
                <div class="vaga-info">
                  <div class="vaga-badges">
                    <% if (bico.status === 'Aberto') { %>
                      <span class="badge badge-open">ABERTO</span>
                    <% } else if (bico.status === 'Em andamento') { %>
                      <span class="badge badge-filled">EM ANDAMENTO</span>
                    <% } else { %>
                      <span class="badge badge-default"><%= bico.status.toUpperCase() %></span>
                    <% } %>

                    <span class="vaga-date" style="margin-left: 8px;">📍 <%= bico.bairro %></span>
                    <span class="vaga-price" style="font-weight: 600; color: #0f172a; margin-left: 8px;">R$ <%= Number(bico.valor || 0).toFixed(2) %></span>
                  </div>

                  <h3 class="vaga-title"><%= bico.titulo %></h3>
                  <p class="vaga-location"><%= bico.descricao %></p>
                </div>

                <div class="vaga-actions">
