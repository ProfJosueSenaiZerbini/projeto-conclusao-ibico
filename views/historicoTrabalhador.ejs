<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ibico | Histórico de Bicos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/historicoTrabalhador.css">
</head>

<body>

    <%- include('Partials/headertrabalhador') %>

        <main class="page">
            <h1 class="page__title">Seu Histórico de Bicos</h1>
            <p class="page__subtitle">Acompanhe suas candidaturas e serviços confirmados em um só lugar.</p>

            <!-- Botões das Abas -->
            <div class="tabs" role="tablist">
                <button class="tab tab--active" onclick="trocarAba(event, 'aceitos')">
                    Bicos Aceitos (<%= aceitos.length %>)
                </button>
                <button class="tab" onclick="trocarAba(event, 'pendentes')">
                    Bicos Pendentes (<%= pendentes.length %>)
                </button>
            </div>

            <div class="tab-content">
                <!-- Conteúdo: Bicos Aceitos -->
                <div class="tab-panel tab-panel--active" id="aceitos">
                    <% if (aceitos.length===0) { %>
                        <p style="color: #666; margin-top: 20px;">Você ainda não possui bicos aceitos.</p>
                        <% } else { %>
                            <ul class="bicos-list">
                                <% aceitos.forEach(bico=> { %>
                                    <li class="bico-card">
                                        <div class="bico-card__header">
                                            <h3>
                                                <%= bico.titulo %>
                                            </h3>
                                            <span class="badge badge--success">
                                                <%= bico.bico_status %>
                                            </span>
                                        </div>
                                        <p class="bico-card__desc">
                                            <%= bico.descricao %>
                                        </p>
                                        <div class="bico-card__footer">
                                            <span><strong>Valor:</strong> R$ <%=
                                                    Number(bico.valor).toFixed(2).replace('.', ',' ) %></span>
                                            <span><strong>Data:</strong>
                                                <%= bico.data_servico_formatada %>
                                            </span>
                                        </div>
                                    </li>
                                    <% }); %>
                            </ul>
                            <% } %>
                </div>

                <!-- Conteúdo: Bicos Pendentes -->
                <div class="tab-panel" id="pendentes" style="display: none;">
                    <% if (pendentes.length===0) { %>
                        <p style="color: #666; margin-top: 20px;">Você não tem nenhuma candidatura pendente.</p>
                        <% } else { %>
                            <ul class="bicos-list">
                                <% pendentes.forEach(bico=> { %>
                                    <li class="bico-card">
                                        <div class="bico-card__header">
                                            <h3>
                                                <%= bico.titulo %>
                                            </h3>
                                            <span class="badge badge--warning">Pendente</span>
                                        </div>
                                        <p class="bico-card__desc">
                                            <%= bico.descricao %>
                                        </p>
                                        <div class="bico-card__footer">
                                            <span><strong>Valor:</strong> R$ <%=
                                                    Number(bico.valor).toFixed(2).replace('.', ',' ) %></span>
                                            <span><strong>Data:</strong>
                                                <%= bico.data_servico_formatada %>
                                            </span>
                                        </div>
                                    </li>
                                    <% }); %>
                            </ul>
                            <% } %>
                </div>
            </div>
        </main>

        <script>
            function trocarAba(event, tabId) {
                // Esconde todos os painéis
                document.querySelectorAll('.tab-panel').forEach(panel => panel.style.display = 'none');
                // Remove a classe ativa dos botões
                document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('tab--active'));

                // Mostra o painel selecionado e ativa o botão
                document.getElementById(tabId).style.display = 'block';
                event.currentTarget.classList.add('tab--active');
            }
        </script>

        <%- include('Partials/footer') %>

            <script src="/js/historicoTrabalhador.js"></script>
</body>

</html>