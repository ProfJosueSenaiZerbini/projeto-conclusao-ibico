<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ibico | Histórico de Bicos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/historicoTrabalhador.css">
</head>

<body>

   <%- include('partials/headerTrabalhador') %>

    <main class="page">
        <h1 class="page__title">Seu Histórico de Bicos</h1>
        <p class="page__subtitle">Acompanhe suas candidaturas e serviços confirmados em um só lugar.</p>

        <div class="tabs" role="tablist">
            <button class="tab tab--active" id="tab-aceitos" role="tab" aria-selected="true" data-target="aceitos">Bicos
                Aceitos</button>
            <button class="tab" id="tab-pendentes" role="tab" aria-selected="false" data-target="pendentes">Bicos
                Pendentes</button>
        </div>

        <div class="tab-content">
            <div class="tab-panel tab-panel--active" id="aceitos" role="tabpanel" aria-labelledby="tab-aceitos">
                <ul class="bicos-list" id="bicosAceitosList">
                    <!-- Bicos aceitos serão carregados aqui via JS -->
                </ul>
            </div>
            <div class="tab-panel" id="pendentes" role="tabpanel" aria-labelledby="tab-pendentes">
                <ul class="bicos-list" id="bicosPendentesList">
                    <!-- Bicos pendentes serão carregados aqui via JS -->
                </ul>
            </div>
    </main>

   <%- include('partials/footer') %>

    <script src="/js/historicoTrabalhador.js"></script>
</body>

</html>