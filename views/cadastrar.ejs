<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Conta — Ibico</title>
  <link rel="stylesheet" href="/css/cadastro.css">
</head>

<body class="theme-contratante">
  <main class="page">
    <div class="auth-split">
      <div class="auth-split-visual" aria-hidden="true">
        <div class="visual-copy">
          <span class="tag-pill" id="visualTag">Oportunidades Locais</span>
          <h1 id="visualTitle">Conectando talentos a demandas locais com clareza e agilidade.</h1>
          <p id="visualDesc">Junte-se a milhares de profissionais e contratantes na plataforma de micro-freelas mais confiável do país.</p>
        </div>

        <svg class="community-connections" viewBox="0 0 1440 900" preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="connectionContractorToWorker">
              <stop offset="0%" stop-color="#14532d" />
              <stop offset="100%" stop-color="#8f1d18" />
            </linearGradient>
            <linearGradient id="connectionWorkerToContractor" x1="100%" x2="0%">
              <stop offset="0%" stop-color="#8f1d18" />
              <stop offset="100%" stop-color="#14532d" />
            </linearGradient>
          </defs>
          <path class="connection-contractor-to-worker" d="M274 282 C360 302 385 366 470 390 C585 423 666 435 720 450 C820 478 900 409 970 373 C1045 335 1093 296 1166 282" />
          <path class="connection-worker-to-contractor" d="M1168 622 C1080 603 1050 543 967 517 C855 482 785 470 720 450 C625 421 545 493 470 529 C390 567 341 608 272 622" />
          <circle class="contractor-node" cx="274" cy="282" r="4" />
          <circle class="contractor-node" cx="272" cy="622" r="4" />
          <circle class="worker-node" cx="1166" cy="282" r="4" />
          <circle class="worker-node" cx="1168" cy="622" r="4" />
        </svg>

        <div class="profile-person contractor-cluster person-top-left">
          <img src="/img/perfil-contratante-profissional.png" alt="">
          <span class="service-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18" /></svg>
          </span>
        </div>
        <div class="profile-person contractor-cluster person-bottom-left">
          <img src="/img/perfil-contratante-servico.png" alt="">
          <span class="service-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.7-3.7a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z" /></svg>
          </span>
        </div>
        <div class="profile-person worker-cluster person-top-right">
          <img src="/img/perfil-trabalhador-servico.png" alt="">
          <span class="service-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="m14.7 6.3 3-3a6 6 0 0 0 3 8l-9 9a2 2 0 0 1-3-3l9-9a6 6 0 0 0-8-3l3-3" /><path d="m5 19 3 3" /></svg>
          </span>
        </div>
        <div class="profile-person worker-cluster person-bottom-right">
          <img src="/img/perfil-trabalhador-entrega.png" alt="">
          <span class="service-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
          </span>
        </div>
        <img class="mascot-node mascot-araponga" src="/img/mascote-araponga.png" alt="">
        <img class="mascot-node mascot-tie" src="/img/mascote-tie-sangue.png" alt="">

      </div>

      <section class="auth-split-form" aria-labelledby="signupTitle">
        <div class="auth-box">
          <a href="/login" class="brand teal"><span class="brand-dot"></span>Ibico</a>
          <h1 class="auth-title" id="signupTitle">Criar sua conta</h1>
          <p class="auth-sub" id="signupSubtitle">Escolha seu perfil e comece a usar o iBico.</p>

          <% if (erro) { %>
            <div class="erro-passarinho-cadastro">
              <img src="/img/passarinho_transparente.png" alt="Passarinho">
              <div class="balao-erro-cadastro">
                <img src="/img/balao_transparente.png" alt="">
                <span><%= erro %></span>
              </div>
            </div>
          <% } %>

          <label class="role-label">Eu quero...</label>
          <div class="role-toggle" id="cadastroRoleToggle">
            <div class="role-card active" data-role="contratante" id="cardContratante">
              <div class="role-icon">💼</div>
              <span>Quero Contratar</span>
            </div>
            <div class="role-card" data-role="trabalhador" id="cardTrabalhador">
              <div class="role-icon">🛠️</div>
              <span>Quero Trabalhar</span>
            </div>
          </div>

          <form action="/cadastrar" method="POST" id="cadastroForm">
            <input type="hidden" name="tipoPerfil" id="tipoPerfilInput"
              value="<%= dados?.tipoPerfil || 'Contratante' %>">

            <div id="fieldsContratante">
              <div class="input-row">
                <div class="field">
                  <label for="nome">Nome Completo</label>
                  <input class="input" type="text" id="nome" name="nome" placeholder="Ex: João da Silva"
                    value="<%= dados?.nome || '' %>" required minlength="3" maxlength="100">
                </div>
                <div class="field">
                  <label for="cEmail">E-mail</label>
                  <input class="input" type="email" id="cEmail" name="email" placeholder="seu@email.com"
                    value="<%= dados?.email || '' %>" required maxlength="100">
                </div>
              </div>

              <div class="field cpf-field">
                <label for="cpf">CPF</label>
                <input class="input" type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14"
                  value="<%= dados?.cpf || '' %>" required>
              </div>
            </div>

            <div id="fieldsTrabalhador">
              <div class="input-row">
                <div class="field"></div>
                <div class="field"></div>
              </div>
            </div>

            <div class="input-row">
              <div class="field">
                <label for="cSenha">Senha</label>
                <div class="input-with-icon">
                  <input class="input" type="password" id="cSenha" name="senha" placeholder="••••••••" required
                    minlength="6" maxlength="72">
                  <button type="button" class="input-icon-btn" data-toggle-password="cSenha"
                    data-toggle-label="senha" aria-label="Mostrar senha" aria-pressed="false">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                      <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="field">
                <label for="cConfirma">Confirmar Senha</label>
                <div class="input-with-icon">
                  <input class="input" type="password" id="cConfirma" name="confirmarSenha" placeholder="••••••••"
                    required minlength="6" maxlength="72">
                  <button type="button" class="input-icon-btn" data-toggle-password="cConfirma"
                    data-toggle-label="confirmação de senha" aria-label="Mostrar confirmação de senha"
                    aria-pressed="false">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                      <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="checkbox-row terms-row">
              <input type="checkbox" id="termos" name="termos" required>
              <label for="termos">Li e aceito os <a href="#" class="hint-link">Termos de Uso</a> e a <a href="#"
                class="hint-link">Política de Privacidade</a>.</label>
            </div>

            <div class="checkbox-row age-row">
              <input type="checkbox" id="idade" name="maiorIdade" value="true" required>
              <label for="idade">Confirmo que possuo 18 anos ou mais.</label>
            </div>

            <button type="submit" class="btn btn-teal btn-block" id="btnSubmit">Finalizar Cadastro</button>
          </form>

          <p class="foot-note">Já possui uma conta? <a href="/login" class="hint-link">Faça o login</a></p>
        </div>
      </section>
    </div>
  </main>

  <script src="/js/cadastrar.js"></script>
</body>

</html>
