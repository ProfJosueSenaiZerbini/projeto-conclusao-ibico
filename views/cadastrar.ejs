<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Conta — Ibico</title>
  <link rel="stylesheet" href="/css/cadastro.css">
</head>

<body class="theme-contratante">

  <div class="page">
    <div class="auth-split" style="flex:1;">

      <!-- PAINEL ESQUERDO: VISUAL COM IMAGEM -->
      <div class="auth-split-visual">
        <span class="tag-pill" id="visualTag">Oportunidades Locais</span>
        <h1 id="visualTitle">Conectando talentos a demandas locais com clareza e agilidade.</h1>
        <p id="visualDesc">Junte-se a milhares de profissionais e contratantes na plataforma de micro-freelas mais
          confiável do país.</p>

        <div class="visual-photo">
          <!-- ESPAÇO RESERVADO PARA A SUA IMAGEM: Substitua o 'src' abaixo quando quiser -->
          <img id="visualImage" src="https://www.coisasdaroca.com/wp-content/uploads/2017/05/v-27-e1496090254861.jpg"
            alt="Ilustração Ibico" height="400px" width="20px">
        </div>
      </div>

      <!-- PAINEL DIREITO: FORMULÁRIOS -->
      <div class="auth-split-form">
        <div class="auth-box" style="max-width:460px; width: 100%;">

          <a href="/login" class="brand teal" style="margin-bottom:18px;"><span class="brand-dot"></span>Ibico</a>
          <h1 class="auth-title" style="font-size:22px;">Criar Nova Conta</h1>
          <p class="auth-sub" style="margin-bottom:6px;">Preencha seus dados para começar a usar o Ibico</p>

          <label style="margin-top:16px;">Eu quero...</label>
          <div class="role-toggle" id="cadastroRoleToggle" style="margin-top:0;">
            <div class="role-card active" data-role="contratante" id="cardContratante">
              <div class="role-icon">💼</div>
              <span>Quero Contratar</span>
            </div>
            <div class="role-card" data-role="trabalhador" id="cardTrabalhador">
              <div class="role-icon">🛠️</div>
              <span>Quero Trabalhar</span>
            </div>
          </div>

          <form action="/cadastrar" method="POST" id="cadastroForm">
            <input type="hidden" name="tipoPerfil" id="tipoPerfilInput" value="Contratante">

            <!-- SEÇÃO DE CAMPOS DO CONTRATANTE -->
            <div id="fieldsContratante">
              <div class="input-row">
                <div class="field">
                  <label for="nome">Nome Completo</label>
                  <input class="input" type="text" id="nome" name="nome" placeholder="Ex: João da Silva" required
                    minlength="3">
                </div>
                <div class="field">
                  <label for="cEmail">E-mail</label>
                  <input class="input" type="email" id="cEmail" name="email" placeholder="seu@email.com" required>
                </div>
              </div>

              <div class="field" style="margin-bottom: 14px;">
                <label for="cpf">CPF</label>
                <input class="input" type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14"
                  required>
              </div>
            </div>

            <!-- SEÇÃO DE CAMPOS EXCLUSIVOS DO TRABALHADOR (Inicialmente oculta) -->
            <div id="fieldsTrabalhador" style="display: none;">
              <div class="input-row">
                <div class="field">

                </div>
                <div class="field">

                </div>
              </div>
            </div>

            <!-- CAMPOS COMUNS (Senhas e Checkboxes) -->
            <div class="input-row">
              <div class="field">
                <label for="cSenha">Senha</label>
                <div class="input-with-icon">
                  <input class="input" type="password" id="cSenha" name="senha" placeholder="••••••••" required
                    minlength="6">
                  <button type="button" class="input-icon-btn" data-toggle-password="cSenha">👁️</button>
                </div>
              </div>
              <div class="field">
                <label for="cConfirma">Confirmar Senha</label>
                <div class="input-with-icon">
                  <input class="input" type="password" id="cConfirma" name="confirmarSenha" placeholder="••••••••"
                    required minlength="6">
                  <button type="button" class="input-icon-btn" data-toggle-password="cConfirma">👁️</button>
                </div>
              </div>
            </div>

            <div class="checkbox-row" style="margin-bottom:8px;">
              <input type="checkbox" id="termos" name="termos" required>
              <label for="termos">Li e aceito os <a href="#" class="hint-link">Termos de Uso</a> e a <a href="#"
                  class="hint-link">Política de Privacidade</a>.</label>
            </div>

            <div class="checkbox-row" style="margin-bottom:20px;">
              <input type="checkbox" id="idade" name="maiorIdade" value="true" required>
              <label for="idade">Confirmo que possuo 18 anos ou mais.</label>
            </div>

            <button type="submit" class="btn btn-teal btn-block" id="btnSubmit">Finalizar Cadastro</button>
          </form>

          <p class="foot-note">Já possui uma conta? <a href="/login" class="hint-link">Faça o login</a></p>
        </div>
      </div>

    </div>
  </div>

  <script src="/js/cadastrar.js"></script>
</body>

</html>