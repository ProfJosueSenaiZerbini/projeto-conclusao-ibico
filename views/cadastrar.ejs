<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Conta — Ibico</title>
  <link rel="stylesheet" href="/css/cadastro.css">
</head>

<body class="theme-contratante">

  <div class="page">
    <div class="auth-split">

      <!-- PAINEL ESQUERDO: VISUAL COM IMAGEM -->
      <div class="auth-split-visual">
        <span class="tag-pill" id="visualTag">Oportunidades Locais</span>
        <h1 id="visualTitle">Conectando talentos a demandas locais com clareza e agilidade.</h1>
        <p id="visualDesc">Junte-se a milhares de profissionais e contratantes na plataforma de micro-freelas mais
          confiável do país.</p>

        <div class="visual-photo">
          <!-- ESPAÇO RESERVADO PARA A SUA IMAGEM: Substitua o 'src' abaixo quando quiser -->
          <img id="visualImage" src="https://www.coisasdaroca.com/wp-content/uploads/2017/05/v-27-e1496090254861.jpg"
            alt="Ilustração Ibico">
        </div>
      </div>

      <!-- PAINEL DIREITO: FORMULÁRIOS -->
      <div class="auth-split-form">
        <div class="auth-box">

          <a href="/login" class="brand teal"><span class="brand-dot"></span>Ibico</a>
          <h1 class="auth-title" id="signupTitle">Criar sua conta</h1>
          <p class="auth-sub" id="signupSubtitle">Escolha seu perfil e comece a usar o iBico.</p>

          <% if (erro) { %>
            <div class="erro-passarinho-cadastro">
              <img src="/img/passarinho_transparente.png" alt="Passarinho">

              <div class="balao-erro-cadastro">
                <img src="/img/balao_transparente.png" alt="">
                <span>
                  <%= erro %>
                </span>
              </div>
            </div>
            <% } %>

              <label class="role-label">Eu quero...</label>
              <div class="role-toggle" id="cadastroRoleToggle">
                <div class="role-card active" data-role="contratante" id="cardContratante">
                  <div class="role-icon">💼</div>
                  <span>Quero Contratar</span>
                </div>
                <div class="role-card" data-role="trabalhador" id="cardTrabalhador">
                  <div class="role-icon">🛠️</div>
                  <span>Quero Trabalhar</span>
                </div>
              </div>

              <form action="/cadastrar" method="POST" id="cadastroForm">
                <input type="hidden" name="tipoPerfil" id="tipoPerfilInput"
                  value="<%= dados?.tipoPerfil || 'Contratante' %>">

                <!-- SEÇÃO DE CAMPOS DO CONTRATANTE -->
                <div id="fieldsContratante">
                  <div class="input-row">
                    <div class="field">
                      <label for="nome">Nome Completo</label>
                      <input class="input" type="text" id="nome" name="nome" placeholder="Ex: João da Silva"
                        value="<%= dados?.nome || '' %>" required minlength="3" maxlength="100">
                    </div>
                    <div class="field">
                      <label for="cEmail">E-mail</label>
                      <input class="input" type="email" id="cEmail" name="email" placeholder="seu@email.com"
                        value="<%= dados?.email || '' %>" required maxlength="100">
                    </div>
                  </div>

                  <div class="field cpf-field">
                    <label for="cpf">CPF</label>
                    <input class="input" type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14"
                      value="<%= dados?.cpf || '' %>" required>
                  </div>
                </div>

                <!-- SEÇÃO DE CAMPOS EXCLUSIVOS DO TRABALHADOR (Inicialmente oculta) -->
                <div id="fieldsTrabalhador">
                  <div class="input-row">
                    <div class="field">

                    </div>
                    <div class="field">

                    </div>
                  </div>
                </div>

                <!-- CAMPOS COMUNS (Senhas e Checkboxes) -->
                <div class="input-row">
                  <div class="field">
                    <label for="cSenha">Senha</label>
                    <div class="input-with-icon">
                      <input class="input" type="password" id="cSenha" name="senha" placeholder="••••••••" required
                        minlength="6" maxlength="72">
                      <button type="button" class="input-icon-btn" data-toggle-password="cSenha"
                        data-toggle-label="senha" aria-label="Mostrar senha" aria-pressed="false">
                        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                          <path
                            d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="field">
                    <label for="cConfirma">Confirmar Senha</label>
                    <div class="input-with-icon">
                      <input class="input" type="password" id="cConfirma" name="confirmarSenha" placeholder="••••••••"
                        required minlength="6" maxlength="72">
                      <button type="button" class="input-icon-btn" data-toggle-password="cConfirma"
                        data-toggle-label="confirmação de senha" aria-label="Mostrar confirmação de senha"
                        aria-pressed="false">
                        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                          <path
                            d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="checkbox-row terms-row">
                  <input type="checkbox" id="termos" name="termos" required>
                  <label for="termos">Li e aceito os <a href="#" class="hint-link">Termos de Uso</a> e a <a href="#"
                      class="hint-link">Política de Privacidade</a>.</label>
                </div>

                <div class="checkbox-row age-row">
                  <input type="checkbox" id="idade" name="maiorIdade" value="true" required>
                  <label for="idade">Confirmo que possuo 18 anos ou mais.</label>
                </div>

                <button type="submit" class="btn btn-teal btn-block" id="btnSubmit">Finalizar Cadastro</button>
              </form>

              <p class="foot-note">Já possui uma conta? <a href="/login" class="hint-link">Faça o login</a></p>
        </div>
      </div>

    </div>
  </div>

  <script src="/js/cadastrar.js"></script>
</body>

</html>